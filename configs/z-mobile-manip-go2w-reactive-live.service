[Unit]
Description=Z-Mobile-Manip Go2W single-owner reactive WebRTC control
After=network-online.target
Wants=network-online.target
Conflicts=z-manip-go2w-base-control.service z-mobile-manip-go2w-reactive-shadow.service
# H5.  KEEP A LIMITER, EXPLICIT AND WIDER.
#
# This is the single owner of the ONLY channel that reaches the base.  A
# crash-looping WebRTC bridge is precisely the "ROS accepts /cmd_vel but the
# robot never receives it" state go2w_base_transport_preflight.sh exists to
# catch, so latching it is right: the preflight then fails loudly instead of
# handing the servo an authority it does not have.
#
# The inherited 5-per-10 s is nevertheless wrong here, because the preflight
# RESTARTS this unit itself.  Before the InvocationID fix that was every ~12 min
# on a perfectly healthy bridge; it is now rare, but an operator retrying a live
# task still drives one restart per launch, and the 12 s the preflight waits for
# readiness makes a burst of retries easy.
#
# 60 s / 8, NOT the 60 s / 10 first written here.  "A 3 s crash loop latches in
# ~30 s" counted RestartSec alone and modelled every failed start as taking zero
# time; the real cycle is uptime + RestartSec, and at 60/10 this unit only
# latched a loop whose failed starts died within 60/9 - 3 = 3.67 s.  60 s / 8
# latches a crash loop whose failed starts survive up to 60/7 - 3 = 5.57 s.
# Eight operator launches per minute is still unreachable in practice: the
# preflight waits up to 12 s for readiness on each one.
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
EnvironmentFile=-%h/.config/z-mobile-manip/go2w-reactive-live.env
ExecStart=%h/.local/lib/z-mobile-manip/go2w_reactive_control_nuc.sh live
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
