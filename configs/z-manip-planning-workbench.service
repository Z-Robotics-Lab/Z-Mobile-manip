[Unit]
Description=Z-Manip loopback planning-only workbench
After=default.target docker.service
# H5.  THE ONE UNIT THAT SHOULD RETRY FOREVER, following the deliberate
# StartLimitIntervalSec=0 precedent already set by d435i.service:4 and
# ffs-ir-throttle.service:4.
#
# Differences from the three NUC units, each of which keeps a limiter:
#   * it owns no exclusive hardware -- no CAN bus, no WebRTC channel -- so
#     "retry forever" cannot fight another owner for a resource;
#   * its characteristic failure is a start-order race, not a fault.  It is
#     ``After=docker.service`` and binds port 8766, so a docker socket that is
#     not ready yet, or a previous instance that has not released the port, both
#     produce a short burst of failed starts that a retry cures.  With
#     RestartSec=2 the inherited 5-per-10 s latches on exactly that burst;
#   * IT IS THE OPERATOR'S ONLY INTERFACE.  Every other unit that latches
#     announces itself by failing an action the operator just requested.  This
#     one announces itself as a browser tab that stops updating, and there is no
#     second channel through which they would learn the limiter had tripped.
#
# The failure this does NOT protect against -- a workbench that is genuinely
# broken and restarts every 2 s forever -- is loud in `systemctl --user status`
# and costs nothing but log lines, whereas a latched workbench costs the whole
# session.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Z-Robotics-Lab/Z-Mobile-manip
ExecStart=/usr/bin/python3 %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/go2w_planning_control.py --run-root %h/Z-Robotics-Lab/artifacts/go2w_real/planning_sessions --session-script %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/go2w_planning_session.sh --home-script %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/piper_home_remote.sh --grasp-script %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/piper_full_grasp_remote.py --approach-script %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/go2w_depth_servo.sh --approach-status %h/Z-Robotics-Lab/artifacts/go2w_real/latest/depth-servo.json --wrist-search-script %h/Z-Robotics-Lab/Z-Mobile-manip/scripts/runtime/piper_wrist_search_remote.sh --index %h/Z-Robotics-Lab/Z-Mobile-manip/web/debug_dashboard/index.html --runtime-state %h/Z-Robotics-Lab/artifacts/go2w_real/latest/runtime-observer.json --camera-image %h/Z-Robotics-Lab/artifacts/go2w_real/latest/camera-latest.jpg --depth-image %h/Z-Robotics-Lab/artifacts/go2w_real/latest/depth-latest.jpg --cloud-bin %h/Z-Robotics-Lab/artifacts/go2w_real/latest/cloud-latest.bin --port 8766
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
